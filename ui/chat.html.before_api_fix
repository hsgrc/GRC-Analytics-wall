        document.getElementById(
            "newChat"
        );


    /* =========================================================
       LANGUAGE
       ========================================================= */

    const languageSelector =
        document.getElementById(
            "languageSelector"
        );

    const languageBtn =
        document.getElementById(
            "languageBtn"
        );

    const languageMenu =
        document.getElementById(
            "languageMenu"
        );

    const selectedLanguage =
        document.getElementById(
            "selectedLanguage"
        );


    let currentLanguage =
        localStorage.getItem(
            "grc_selected_language"
        ) || "English";



    /* =========================================================
       GRC LIVE — LOCAL VOICE
       ========================================================= */

    const grcLiveBtn =
        document.getElementById("grcLiveBtn");

    const grcLiveOverlay =
        document.getElementById("grcLiveOverlay");

    const grcLiveCard =
        document.getElementById("grcLiveCard");

    const grcLiveStatus =
        document.getElementById("grcLiveStatus");

    const grcLiveTranscript =
        document.getElementById("grcLiveTranscript");

    const grcLiveMic =
        document.getElementById("grcLiveMic");

    const grcLiveEnd =
        document.getElementById("grcLiveEnd");

    const grcLiveMicIcon =
        document.getElementById("grcLiveMicIcon");


    let grcLiveStream = null;
    let grcLiveRecorder = null;
    let grcLiveChunks = [];
    let grcLiveActive = false;
    let grcLiveRecording = false;
    let grcLiveMimeType = "";


    function setGrcLiveStatus(text, state = "idle") {

        grcLiveStatus.textContent = text;

        grcLiveCard.classList.remove(
            "listening",
            "speaking"
        );

        if (state === "listening") {
            grcLiveCard.classList.add("listening");
        }

        if (state === "speaking") {
            grcLiveCard.classList.add("speaking");
        }
    }


    function resetGrcLiveMicIcon() {

        grcLiveMicIcon.innerHTML = `
            <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"></path>
            <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
            <path d="M12 19v4"></path>
            <path d="M8 23h8"></path>
        `;
    }


    function chooseRecorderMimeType() {

        const candidates = [
            "audio/mp4",
            "audio/webm;codecs=opus",
            "audio/webm",
            "audio/ogg;codecs=opus"
        ];

        for (const type of candidates) {

            if (
                window.MediaRecorder &&
                MediaRecorder.isTypeSupported &&
                MediaRecorder.isTypeSupported(type)
            ) {
                return type;
            }
        }

        return "";
    }


    async function startGrcLive() {

        if (grcLiveActive) {
            return;
        }

        if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {

            setGrcLiveStatus(
                "Microphone access is not supported in this browser."
            );

            return;
        }

        try {

            grcLiveStream =
                await navigator.mediaDevices.getUserMedia({
                    audio: {
                        channelCount: 1,
                        echoCancellation: true,
                        noiseSuppression: true,
                        autoGainControl: true
                    }
                });

            grcLiveActive = true;

            grcLiveBtn.classList.add("live-active");

            setGrcLiveStatus(
                "Ready — tap the microphone to speak."
            );

            grcLiveTranscript.textContent =
                "GRC Live is ready. Choose your language and start speaking.";

        }
        catch (error) {

            console.error("GRC Live microphone error:", error);

            setGrcLiveStatus(
                "Microphone permission was not granted."
            );
        }
    }


    function stopGrcLiveRecording() {

        if (!grcLiveRecorder) {
            return;
        }

        if (grcLiveRecorder.state !== "inactive") {
            grcLiveRecorder.stop();
        }
    }


    function releaseGrcLiveStream() {

        if (grcLiveStream) {

            grcLiveStream
                .getTracks()
                .forEach(track => track.stop());

            grcLiveStream = null;
        }
    }


    async function sendGrcLiveAudio(blob) {

        setGrcLiveStatus(
            "GRC is listening to your message..."
        );

        grcLiveTranscript.textContent =
            "Processing your voice...";

        try {

            const formData = new FormData();

            formData.append(
                "audio",
                blob,
                `grc-live-${Date.now()}.${blob.type.includes("mp4") ? "mp4" : "webm"}`
            );

            formData.append(
                "language",
                currentLanguage
            );

            const response =
                await fetch(
                    "/api/voice-chat",
                    {
                        method: "POST",
                        body: formData
                    }
                );

            const data =
                await response.json();

            if (!response.ok) {
                throw new Error(
                    data.detail ||
                    "Local voice service failed."
                );
            }

            const transcript =
                data.transcript ||
                "";

            const answer =
                data.answer ||
                "";

            if (transcript) {
                grcLiveTranscript.textContent =
                    `You: ${transcript}` +
                    (answer ? `\n\nGRC: ${answer}` : "");
            }
            else {
                grcLiveTranscript.textContent =
                    answer ||
                    "GRC did not detect any speech.";
            }

            if (data.audio_base64) {

                setGrcLiveStatus(
                    "GRC is speaking...",
                    "speaking"
                );

                const audio = new Audio(
                    `data:${data.audio_mime || "audio/wav"};base64,${data.audio_base64}`
                );

                audio.onended = () => {

                    if (grcLiveActive) {

                        setGrcLiveStatus(
                            "Ready — tap the microphone to speak."
                        );
                    }
                };

                await audio.play();

            }
            else {

                setGrcLiveStatus(
                    "GRC replied, but no voice audio was returned."
                );
            }

        }
        catch (error) {

            console.error(
                "GRC Live local voice error:",
                error
            );

            grcLiveTranscript.textContent =
                "";

            setGrcLiveStatus(
                "GRC Live error: " + (error?.message || String(error))
            );
        }
    }


    function startGrcLiveRecording() {

        if (!grcLiveActive || !grcLiveStream) {

            setGrcLiveStatus(
                "Start GRC Live first."
            );

            return;
        }

        if (!window.MediaRecorder) {

            setGrcLiveStatus(
                "This browser does not support microphone recording."
            );

            return;
        }

        try {

            grcLiveMimeType =
                chooseRecorderMimeType();

            grcLiveChunks = [];

            const options =
                grcLiveMimeType
                    ? { mimeType: grcLiveMimeType }
                    : undefined;

            grcLiveRecorder =
                new MediaRecorder(
                    grcLiveStream,
                    options
                );

            grcLiveRecorder.ondataavailable =
                event => {

                    if (event.data && event.data.size > 0) {
                        grcLiveChunks.push(event.data);
                    }
                };

            grcLiveRecorder.onstart =
                () => {

                    grcLiveRecording = true;

                    grcLiveMic.classList.add("recording");

                    grcLiveMic.setAttribute(
                        "aria-label",
                        "Stop recording"
                    );

                    setGrcLiveStatus(
                        "Listening... tap the microphone when you're finished.",
                        "listening"
                    );

                    grcLiveTranscript.textContent =
                        "Listening...";
                };

            grcLiveRecorder.onstop =
                async () => {

                    grcLiveRecording = false;

                    grcLiveMic.classList.remove("recording");

                    grcLiveMic.setAttribute(
                        "aria-label",
                        "Start recording"
                    );

                    resetGrcLiveMicIcon();

                    const type =
                        grcLiveMimeType ||
                        "audio/webm";

                    const blob =
                        new Blob(
                            grcLiveChunks,
                            { type }
                        );

                    grcLiveChunks = [];

                    if (!blob.size) {

                        setGrcLiveStatus(
                            "No voice was captured. Try again."
                        );

                        return;
                    }

                    await sendGrcLiveAudio(blob);
                };

            grcLiveRecorder.start();
        }
        catch (error) {

            console.error(
                "GRC Live recorder error:",
                error
            );

            setGrcLiveStatus(
                "Could not start voice recording."
            );
        }
    }


    function endGrcLive() {

        grcLiveActive = false;

        if (
            grcLiveRecorder &&
            grcLiveRecorder.state !== "inactive"
        ) {
            grcLiveRecorder.stop();
        }

        grcLiveRecorder = null;
        grcLiveRecording = false;
        grcLiveChunks = [];

        releaseGrcLiveStream();

        grcLiveBtn.classList.remove("live-active");
        grcLiveMic.classList.remove("recording");
        resetGrcLiveMicIcon();

        grcLiveOverlay.classList.remove("active");
        grcLiveOverlay.setAttribute("aria-hidden", "true");

        setGrcLiveStatus(
            "Ready to talk"
        );

        grcLiveTranscript.textContent =
            "Tap the microphone and start speaking.";
    }


    if (grcLiveBtn) {

        grcLiveBtn.addEventListener(
            "click",
            async () => {

                grcLiveOverlay.classList.add("active");
                grcLiveOverlay.setAttribute("aria-hidden", "false");

                await startGrcLive();
            }
        );
    }


    if (grcLiveMic) {

        grcLiveMic.addEventListener(
            "click",
            () => {

                if (!grcLiveActive) {
                    return;
                }

                if (grcLiveRecording) {
                    stopGrcLiveRecording();
                }
                else {
                    startGrcLiveRecording();
                }
            }
        );
    }


    if (grcLiveEnd) {

        grcLiveEnd.addEventListener(
            "click",
            endGrcLive
        );
    }


    if (grcLiveOverlay) {

        grcLiveOverlay.addEventListener(
            "click",
            event => {

                if (event.target === grcLiveOverlay) {
                    endGrcLive();
                }
            }
        );
    }


    window.addEventListener(
        "beforeunload",
        () => {
            releaseGrcLiveStream();
        }
    );


    function updateLanguageUI() {

