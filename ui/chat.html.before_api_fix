    }


    function hideTyping() {

        const typing =
            document.getElementById(
                "typing"
            );


        if (
            typing
        ) {

            typing.remove();

        }

    }


    /* =========================================================
       TEXTAREA RESIZE
       ========================================================= */

    function autoResize() {

        input.style.height =
            "auto";


        input.style.height =
            Math.min(
                input.scrollHeight,
                150
            ) + "px";

    }


    /* =========================================================
       LANGUAGE INSTRUCTION
       ========================================================= */

    function buildBackendMessage(
        question
    ) {

        /*
         * Current backend accepts only "message".
         * We therefore keep the API unchanged and add
         * the selected language as an instruction inside
         * the message sent to the model.
         *
         * The original question is still displayed to
         * the customer exactly as typed.
         */

        if (
            currentLanguage ===
            "English"
        ) {

            return question;

        }


        return `
Please answer in ${currentLanguage}.

Customer question:
${question}
        `.trim();

    }


    /* =========================================================
       SEND MESSAGE
       ========================================================= */

    async function sendMessage(
        rawMessage
    ) {

        const message =
            rawMessage.trim();


        if (
            !message ||
            send.disabled
        ) {

            return;

        }


        /*
         * Show ONLY the actual customer question.
         */

        addMessage(
            message,
            "user"
        );


        input.value =
            "";


        autoResize();


        send.disabled =
            true;


        showTyping();


        try {

            const response =
                await fetch(
                    "/api/chat",
                    {
                        method:
                            "POST",

                        headers: {
                            "Content-Type":
                                "application/json"
                        },

                        body:
                            JSON.stringify({
                                message:
                                    buildBackendMessage(
                                        message
                                    )
                            })
                    }
                );


            const data =
                await response.json();


            hideTyping();


            if (
                !response.ok
            ) {

                throw new Error(
                    data.detail ||
                    "Request failed"
                );

            }


            /*
             * Only final response is shown.
             */

            addMessage(
                data.answer,
                "bot"
            );


        }
        catch (
            error
        ) {

            hideTyping();


            addMessage(
                "Sorry, I couldn't process that request right now.",
                "bot"
            );

        }
        finally {

            send.disabled =
                false;


            input.focus();

        }

    }


    /* =========================================================
       FORM SUBMIT
       ========================================================= */

    form.addEventListener(
        "submit",
        function(event) {

            event.preventDefault();


            sendMessage(
                input.value
            );

        }
    );


    /* =========================================================
       ENTER TO SEND
       ========================================================= */

    input.addEventListener(
        "keydown",
        function(event) {

            if (
                event.key === "Enter" &&
                !event.shiftKey
            ) {

                event.preventDefault();


                form.requestSubmit();

            }

        }
    );


    /* =========================================================
       AUTO RESIZE
       ========================================================= */

    input.addEventListener(
        "input",
        autoResize
    );


    /* =========================================================
       QUICK QUESTIONS
       ========================================================= */

    document
        .querySelectorAll(
            ".suggestion"
        )
        .forEach(
            function(button) {

                button.addEventListener(
                    "click",
                    function() {

                        sendMessage(
                            this.dataset.question
                        );

                    }
                );

            }
        );


    /* =========================================================
       NEW CHAT
       ========================================================= */

    newChat.addEventListener(
        "click",
        function() {

            messages.innerHTML =
                "";


            messages.appendChild(
                welcome
            );


            welcome.classList.remove(
                "hidden"
            );


            input.value =
                "";


            autoResize();


            input.focus();

        }
    );


    /* =========================================================
       INITIAL
       ========================================================= */

    autoResize();

    input.focus();

</script>

