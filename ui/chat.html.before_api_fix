                    .01ms !important;

                animation-iteration-count:
                    1 !important;

                transition-duration:
                    .01ms !important;

                scroll-behavior:
                    auto !important;
            }
        }

    

        /* =========================================================
           GRC LIVE — LOCAL VOICE UI
           ========================================================= */

        .grc-live-btn {
            height: 41px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 0 14px;
            border: 1px solid rgba(23,32,51,.10);
            border-radius: 13px;
            color: #fff;
            background: linear-gradient(145deg, #172033, #405477);
            font-size: 12px;
            font-weight: 750;
            cursor: pointer;
            box-shadow: 0 8px 22px rgba(23,32,51,.16);
            transition: transform .18s ease, box-shadow .18s ease, filter .18s ease;
        }

        .grc-live-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 12px 26px rgba(23,32,51,.21);
            filter: brightness(1.04);
        }

        .grc-live-btn:active {
            transform: scale(.98);
        }

        .grc-live-btn .live-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #55e6b1;
            box-shadow: 0 0 0 0 rgba(85,230,177,.45);
        }

        .grc-live-btn.live-active .live-dot {
            animation: grcLivePulse 1.7s infinite;
        }

        @keyframes grcLivePulse {
            0%   { box-shadow: 0 0 0 0 rgba(85,230,177,.48); }
            70%  { box-shadow: 0 0 0 8px rgba(85,230,177,0); }
            100% { box-shadow: 0 0 0 0 rgba(85,230,177,0); }
        }

        .grc-live-overlay {
            position: fixed;
            inset: 0;
            z-index: 5000;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            background: rgba(14,21,35,.58);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
            transition: opacity .22s ease, visibility .22s ease;
        }

        .grc-live-overlay.active {
            opacity: 1;
            visibility: visible;
            pointer-events: auto;
        }

        .grc-live-card {
            width: min(470px, 100%);
            padding: 30px 24px 24px;
            border-radius: 30px;
            background: rgba(255,255,255,.96);
            border: 1px solid rgba(255,255,255,.9);
            box-shadow: 0 35px 100px rgba(10,18,35,.25);
            text-align: center;
            transform: translateY(16px) scale(.97);
            transition: transform .28s cubic-bezier(.2,.8,.2,1);
        }

        .grc-live-overlay.active .grc-live-card {
            transform: translateY(0) scale(1);
        }

        .grc-live-orb {
            position: relative;
            width: 138px;
            height: 138px;
            margin: 2px auto 22px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: radial-gradient(circle at 34% 28%, #7c90ff, #35486f 60%, #172033 100%);
            box-shadow: 0 24px 60px rgba(42,59,101,.26);
        }

        .grc-live-orb::before,
        .grc-live-orb::after {
            content: "";
            position: absolute;
            border-radius: 50%;
            border: 1px solid rgba(100,120,165,.22);
            animation: grcLiveRing 2.4s ease-out infinite;
        }

        .grc-live-orb::before { inset: -10px; }
        .grc-live-orb::after { inset: -23px; animation-delay: .75s; }

        .grc-live-card.listening .grc-live-orb {
            animation: grcLiveFloat 2.8s ease-in-out infinite;
        }

        .grc-live-card.speaking .grc-live-orb {
            animation: grcLiveSpeak 1.05s ease-in-out infinite;
        }

        @keyframes grcLiveFloat {
            0%,100% { transform: translateY(0) scale(1); }
            50% { transform: translateY(-5px) scale(1.03); }
        }

        @keyframes grcLiveSpeak {
            0%,100% { transform: scale(1); }
            50% { transform: scale(1.055); }
        }

        @keyframes grcLiveRing {
            0% { opacity: .72; transform: scale(.88); }
            100% { opacity: 0; transform: scale(1.18); }
        }

        .grc-live-orb svg {
            width: 44px;
            height: 44px;
            color: #fff;
            position: relative;
            z-index: 2;
        }

        .grc-live-title {
            font-size: 27px;
            line-height: 1.1;
            letter-spacing: -1px;
        }

        .grc-live-status {
            margin-top: 8px;
            min-height: 20px;
            color: var(--muted);
            font-size: 13px;
        }

        .grc-live-transcript {
            min-height: 82px;
            max-height: 150px;
            margin-top: 20px;
            padding: 14px 15px;
            overflow-y: auto;
            border-radius: 16px;
            background: #f4f6fa;
