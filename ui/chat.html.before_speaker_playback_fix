:root {
    --text: #17315b;
    --muted: #7184a4;
    --panel: rgba(255, 254, 252, 0.96);
    --border: rgba(187, 207, 236, 0.76);
    --shadow:
        0 22px 52px rgba(94, 126, 171, 0.18),
        0 5px 14px rgba(100, 132, 176, 0.08),
        inset 0 2px 0 rgba(255, 255, 255, 0.96);
}

body {
    padding: 12px;
    color: var(--text);
    background:
        radial-gradient(
            ellipse at 8% 12%,
            rgba(117, 174, 255, 0.25),
            transparent 36%
        ),
        radial-gradient(
            ellipse at 94% 78%,
            rgba(180, 211, 255, 0.30),
            transparent 34%
        ),
        linear-gradient(135deg, #edf5ff 0%, #f9f8f5 52%, #eaf3ff 100%);
}

body::before,
body::after {
    width: 440px;
    height: 440px;
    filter: blur(90px);
    opacity: 0.48;
}

body::before {
    background: rgba(99, 161, 255, 0.25);
}

body::after {
    background: rgba(179, 204, 255, 0.32);
}

.app {
    width: min(1580px, calc(100% - 4px));
    height: calc(100vh - 24px);
    min-height: 590px;
    border: 1px solid rgba(255, 255, 255, 0.96);
    border-radius: 30px;
    background: linear-gradient(
        145deg,
        rgba(255, 255, 253, 0.97),
        rgba(248, 251, 255, 0.97)
    );
    box-shadow:
        14px 16px 35px rgba(108, 139, 182, 0.16),
        -8px -8px 25px rgba(255, 255, 255, 0.95),
        inset 0 2px 0 #ffffff;
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
}

header {
    position: relative;
    z-index: 2;
    padding: 15px 23px;
    background: linear-gradient(115deg, #fffefc, #f5f9ff);
    border-bottom: 1px solid rgba(190, 209, 235, 0.58);
