            <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"></path>
            <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
            <path d="M12 19v4"></path>
            <path d="M8 23h8"></path>
        `;
    }


    function chooseRecorderMimeType() {

        const candidates = [
            "audio/mp4",
            "audio/webm;codecs=opus",
            "audio/webm",
            "audio/ogg;codecs=opus"
        ];

        for (const type of candidates) {

            if (
                window.MediaRecorder &&
                MediaRecorder.isTypeSupported &&
                MediaRecorder.isTypeSupported(type)
            ) {
                return type;
            }
        }

        return "";
    }


    async function playGrcLiveGreeting() {
        const formData = new FormData();
        formData.append("language", currentLanguage || "Hinglish");

        try {
            setGrcLiveStatus("GRC Live is welcoming you...", "speaking");
            grcLiveTranscript.textContent =
                "GRC Live: Hello sir, welcome to GRC Live! Aap kya dikhana chahte hain?";

            const response = await fetch("/api/live-call-greeting", {
                method: "POST",
                body: formData
            });

            if (!response.ok) {
                let message = "Welcome greeting could not be generated.";
                try {
                    const errorData = await response.json();
                    message = errorData.detail || message;
                } catch (_) {}
                throw new Error(message);
            }

            const audioBlob = await response.blob();
            if (!audioBlob.size) {
                throw new Error("Welcome greeting audio was empty.");
            }

            const audioUrl = URL.createObjectURL(audioBlob);
            const audio = new Audio(audioUrl);
            grcLiveGreetingAudio = audio;

            audio.onended = () => {
                URL.revokeObjectURL(audioUrl);
                if (grcLiveGreetingAudio === audio) {
                    grcLiveGreetingAudio = null;
                }
                if (grcLiveActive) {
                    setGrcLiveStatus("Ready — tap the microphone to speak.");
                }
            };

            audio.onerror = () => {
                URL.revokeObjectURL(audioUrl);
                if (grcLiveGreetingAudio === audio) {
                    grcLiveGreetingAudio = null;
                }
                if (grcLiveActive) {
                    setGrcLiveStatus("Greeting playback failed. Tap the microphone to speak.");
                }
            };

            await audio.play();

        } catch (error) {
            console.error("GRC Live greeting error:", error);
            if (grcLiveGreetingAudio) {
                grcLiveGreetingAudio.pause();
                grcLiveGreetingAudio = null;
            }
            if (grcLiveActive) {
                setGrcLiveStatus("Greeting unavailable — tap the microphone to speak.");
            }
        }
    }


    async function startGrcLive() {

        if (grcLiveActive) {
            return;
        }

        if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {

            setGrcLiveStatus(
                "Microphone access is not supported in this browser."
            );

            return;
        }

        try {

            grcLiveStream =
                await navigator.mediaDevices.getUserMedia({
                    audio: {
                        channelCount: 1,
                        echoCancellation: true,
                        noiseSuppression: true,
                        autoGainControl: true
                    },
                    video: {
                        facingMode: { ideal: "user" },
                        width: { ideal: 1280 },
                        height: { ideal: 720 }
                    }
                });

            if (grcLiveVideo) {
                grcLiveVideo.srcObject = grcLiveStream;
                grcLiveVideo.classList.add("ready");

                if (grcLiveCameraPlaceholder) {
                    grcLiveCameraPlaceholder.textContent =
                        "Camera connected. Live vision analysis will be added next.";
                }

                await grcLiveVideo.play().catch(error => {
                    console.warn("Camera preview playback:", error);
                });
            }

            grcLiveActive = true;

            grcLiveBtn.classList.add("live-active");

            setGrcLiveStatus(
                "Ready — tap the microphone to speak."
            );

            grcLiveTranscript.textContent =
                "GRC Live is ready. Choose your language and start speaking.";

            await playGrcLiveGreeting();

        }
        catch (error) {

            console.error("GRC Live microphone error:", error);

            setGrcLiveStatus(
                "Camera or microphone permission was not granted."
            );
        }
    }


    function stopGrcLiveRecording() {

        if (!grcLiveRecorder) {
            return;
        }

        if (grcLiveRecorder.state !== "inactive") {
            grcLiveRecorder.stop();
        }
    }


    function releaseGrcLiveStream() {

        if (grcLiveStream) {
            grcLiveStream
                .getTracks()
                .forEach(track => track.stop());

            grcLiveStream = null;
        }

        if (grcLiveVideo) {
            grcLiveVideo.pause();
            grcLiveVideo.srcObject = null;
            grcLiveVideo.classList.remove("ready");
        }

        if (grcLiveCameraPlaceholder) {
            grcLiveCameraPlaceholder.textContent =
                "Camera preview will appear here when the call starts.";
        }
    }


    async function sendGrcLiveAudio(blob) {

        setGrcLiveStatus(
            "GRC is listening to your message..."
        );

        grcLiveTranscript.textContent =
            "Processing your voice...";

        try {

            const formData = new FormData();

            formData.append(
                "audio",
                blob,
                `grc-live-${Date.now()}.${blob.type.includes("mp4") ? "mp4" : "webm"}`
            );

            formData.append(
                "language",
                currentLanguage
            );

            // Capture one frame from the active camera for this question.
            if (
                !grcLiveVideo ||
                !grcLiveVideo.videoWidth ||
                !grcLiveVideo.videoHeight
            ) {
                throw new Error("Camera frame is not ready. Check camera permission.");
            }

            const frameCanvas = document.createElement("canvas");
            frameCanvas.width = grcLiveVideo.videoWidth;
            frameCanvas.height = grcLiveVideo.videoHeight;

            const frameContext = frameCanvas.getContext("2d");
            if (!frameContext) {
                throw new Error("Could not capture a camera frame.");
            }

            frameContext.drawImage(
                grcLiveVideo,
                0,
                0,
                frameCanvas.width,
                frameCanvas.height
            );

            const imageBlob = await new Promise(resolve => {
                frameCanvas.toBlob(resolve, "image/jpeg", 0.82);
            });

            if (!imageBlob) {
                throw new Error("Camera frame could not be encoded.");
            }

            formData.append(
                "image",
                imageBlob,
                `grc-live-frame-${Date.now()}.jpg`
            );

            const response =
                await fetch(
                    "/api/live-call-turn",
                    {
                        method: "POST",
                        body: formData
                    }
                );

            const data =
                await response.json();

            if (!response.ok) {
                throw new Error(
                    data.detail ||
                    "Local voice service failed."
                );
            }

            const transcript =
                data.transcript ||
                "";

            const answer =
                data.answer ||
                "";

            if (transcript) {
                grcLiveTranscript.textContent =
                    `You: ${transcript}` +
                    (answer ? `\n\nGRC: ${answer}` : "");
            }
            else {
                grcLiveTranscript.textContent =
                    answer ||
                    "GRC did not detect any speech.";
            }

            if (data.audio_base64) {

                setGrcLiveStatus(
                    "GRC is speaking...",
                    "speaking"
                );

                const audio = new Audio(
                    `data:${data.audio_mime || "audio/wav"};base64,${data.audio_base64}`
                );

                audio.onended = () => {

                    if (grcLiveActive) {

                        setGrcLiveStatus(
                            "Ready — tap the microphone to speak."
                        );
                    }
                };

                await audio.play();

            }
            else {

                setGrcLiveStatus(
                    "GRC replied, but no voice audio was returned."
                );
            }

        }
        catch (error) {

            console.error(
                "GRC Live local voice error:",
                error
            );

            grcLiveTranscript.textContent =
                "";

            setGrcLiveStatus(
                "GRC Live error: " + (error?.message || String(error))
            );
        }
    }


    function startGrcLiveRecording() {

        if (!grcLiveActive || !grcLiveStream) {

            setGrcLiveStatus(
                "Start GRC Live first."
            );

            return;
        }

        if (!window.MediaRecorder) {

            setGrcLiveStatus(
                "This browser does not support microphone recording."
            );

            return;
        }

        try {

            grcLiveMimeType =
                chooseRecorderMimeType();

            grcLiveChunks = [];

            const options =
                grcLiveMimeType
                    ? { mimeType: grcLiveMimeType }
                    : undefined;

            const grcLiveAudioTracks =
                grcLiveStream.getAudioTracks();

            if (!grcLiveAudioTracks.length) {
                throw new Error(
                    "No microphone audio track is available."
                );
            }

            // Record audio only; camera remains active for frame capture.
            const grcLiveAudioStream =
                new MediaStream(grcLiveAudioTracks);

            grcLiveRecorder =
                new MediaRecorder(
                    grcLiveAudioStream,
                    options
                );

            grcLiveRecorder.ondataavailable =
                event => {

                    if (event.data && event.data.size > 0) {
                        grcLiveChunks.push(event.data);
                    }
                };

            grcLiveRecorder.onstart =
                () => {

                    grcLiveRecording = true;

                    grcLiveMic.classList.add("recording");

                    grcLiveMic.setAttribute(
                        "aria-label",
                        "Stop recording"
                    );

                    setGrcLiveStatus(
                        "Listening... tap the microphone when you're finished.",
                        "listening"
                    );

                    grcLiveTranscript.textContent =
                        "Listening...";
                };

            grcLiveRecorder.onstop =
                async () => {

                    grcLiveRecording = false;

                    grcLiveMic.classList.remove("recording");

                    grcLiveMic.setAttribute(
                        "aria-label",
                        "Start recording"
                    );

                    resetGrcLiveMicIcon();

                    const type =
                        grcLiveMimeType ||
                        "audio/webm";

                    const blob =
                        new Blob(
                            grcLiveChunks,
                            { type }
                        );

                    grcLiveChunks = [];

                    if (!blob.size) {

                        setGrcLiveStatus(
                            "No voice was captured. Try again."
                        );

                        return;
                    }

                    await sendGrcLiveAudio(blob);
                };

            grcLiveRecorder.start();
        }
        catch (error) {

            console.error(
                "GRC Live recorder error:",
                error
            );

            setGrcLiveStatus(
                "Could not start voice recording."
            );
        }
    }


    function endGrcLive() {
        if (grcLiveGreetingAudio) {
            grcLiveGreetingAudio.pause();
            grcLiveGreetingAudio.src = "";
            grcLiveGreetingAudio = null;
        }


        grcLiveActive = false;

        if (
            grcLiveRecorder &&
            grcLiveRecorder.state !== "inactive"
        ) {
            grcLiveRecorder.stop();
        }

        grcLiveRecorder = null;
        grcLiveRecording = false;
        grcLiveChunks = [];

        releaseGrcLiveStream();

        grcLiveBtn.classList.remove("live-active");
        grcLiveMic.classList.remove("recording");
        resetGrcLiveMicIcon();

        grcLiveOverlay.classList.remove("active");
        grcLiveOverlay.setAttribute("aria-hidden", "true");

        setGrcLiveStatus(
            "Ready to talk"
        );

        grcLiveTranscript.textContent =
            "Tap the microphone and start speaking.";
    }


