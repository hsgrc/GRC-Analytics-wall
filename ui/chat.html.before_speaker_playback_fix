    function addMessage(
        text,
        role,
        downloadUrl = null
    ) {

        welcome.classList.add(
            "hidden"
        );


        const row =
            document.createElement(
                "div"
            );


        row.className =
            "message-row " +
            (
                role === "user"
                    ? "user-row"
                    : ""
            );


        /* BOT AVATAR */

        if (
            role === "bot"
        ) {

            const avatar =
                document.createElement(
                    "div"
                );


            avatar.className =
                "avatar";


            avatar.textContent =
                "GRC";


            row.appendChild(
                avatar
            );

        }


        const wrap =
            document.createElement(
                "div"
            );


        wrap.className =
            "bubble-wrap";


        const bubble =
            document.createElement(
                "div"
            );


        bubble.className =
            "bubble " +
            (
                role === "user"
                    ? "user-bubble"
                    : "bot-bubble"
            );


        bubble.textContent =
            text;


        const meta =
            document.createElement(
                "div"
            );


        meta.className =
            "meta";


        meta.textContent =
            getTime();


        wrap.appendChild(
            bubble
        );

        if (
            role === "bot" &&
            typeof downloadUrl === "string" &&
            downloadUrl.startsWith("/api/customer-report?session_token=")
        ) {
            const reportLink = document.createElement("a");
            reportLink.href = downloadUrl;
            reportLink.className = "report-download-link";
            reportLink.textContent = "Download Excel Report";
            reportLink.setAttribute(
                "download",
                "GetRightCover_Customer_Report.xlsx"
            );
            wrap.appendChild(reportLink);
        }


        if (role === "bot" && typeof text === "string" && text.trim()) {
            const speakButton = document.createElement("button");
            speakButton.type = "button";
            speakButton.className = "grc-response-speak";
            speakButton.textContent = "🔊 Listen";
            speakButton.title = "Listen to this response";
            speakButton.setAttribute(
                "aria-label",
                "Listen to this GRC response"
            );
            speakButton.style.cssText =
                "margin-top:8px;padding:6px 10px;border:1px solid #d5dce8;" +
                "border-radius:10px;background:#f7f9fc;color:#33415c;" +
                "font-size:12px;cursor:pointer;";

            speakButton.addEventListener("click", async () => {
                speakButton.disabled = true;
                speakButton.textContent = "⌛ Preparing...";
                speakButton.title = "Generating local audio";

                try {
                    const formData = new FormData();
                    formData.append("text", text);
                    formData.append("language", currentLanguage || "Hinglish");

                    const response = await fetch("/api/speak-response", {
                        method: "POST",
                        body: formData
                    });

                    if (!response.ok) {
                        let message = "Could not generate speech.";
                        try {
                            const errorData = await response.json();
                            message = errorData.detail || message;
                        } catch (_) {}
                        throw new Error(message);
                    }

                    const audioBlob = await response.blob();
                    if (!audioBlob.size) {
                        throw new Error("The generated audio was empty.");
                    }

                    if (window.__grcResponseAudio) {
                        window.__grcResponseAudio.pause();
                        window.__grcResponseAudio.currentTime = 0;
                        window.__grcResponseAudio = null;
                    }

                    if (window.__grcResponseSpeechButton) {
                        window.__grcResponseSpeechButton.disabled = false;
                        window.__grcResponseSpeechButton.textContent = "🔊 Listen";
                        window.__grcResponseSpeechButton.title = "Listen to this response";
                    }

                    if (window.__grcResponseAudioUrl) {
                        URL.revokeObjectURL(window.__grcResponseAudioUrl);
                    }

                    const audioUrl = URL.createObjectURL(audioBlob);
                    const audio = new Audio(audioUrl);

                    window.__grcResponseAudio = audio;
                    window.__grcResponseAudioUrl = audioUrl;
                    window.__grcResponseSpeechButton = speakButton;

                    speakButton.textContent = "⏸ Playing...";
                    speakButton.title = "Playing response";

                    const resetButton = () => {
                        speakButton.disabled = false;
                        speakButton.textContent = "🔊 Listen";
                        speakButton.title = "Listen to this response";

                        if (window.__grcResponseAudio === audio) {
                            window.__grcResponseAudio = null;
                            window.__grcResponseSpeechButton = null;

                            if (window.__grcResponseAudioUrl) {
                                URL.revokeObjectURL(window.__grcResponseAudioUrl);
                                window.__grcResponseAudioUrl = null;
                            }
                        }
                    };

                    audio.onended = resetButton;
                    audio.onerror = resetButton;

                    await audio.play();

                } catch (error) {
                    console.error("GRC response speech error:", error);
                    speakButton.disabled = false;
                    speakButton.textContent = "🔊 Listen";
                    speakButton.title = error.message || "Speech playback failed";
                }
            });

            wrap.appendChild(speakButton);
        }

        wrap.appendChild(
            meta
        );


        row.appendChild(
            wrap
        );


        messages.appendChild(
