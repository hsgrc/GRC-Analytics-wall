    /* =========================================================
       LANGUAGE INSTRUCTION
       ========================================================= */

    function buildBackendMessage(
        question
    ) {

        /*
         * Current backend accepts only "message".
         * We therefore keep the API unchanged and add
         * the selected language as an instruction inside
         * the message sent to the model.
         *
         * The original question is still displayed to
         * the customer exactly as typed.
         */

        if (
            currentLanguage ===
            "English"
        ) {

            return question;

        }


        return `
Please answer in ${currentLanguage}.

Customer question:
${question}
        `.trim();

    }



    function classifyChatEndpoint(question) {
        const text = String(question || "").toLowerCase().trim();

        // An explicit phone number or Indian vehicle registration points
        // to customer-specific lookup.
        const hasMobile = /(?:\+?\s*91[\s-]?)?(?:0[\s-]?)?[6-9]\d{9}/.test(text);
        const hasVehicleNumber =
            /\b[A-Z]{2}\s?\d{1,2}\s?[A-Z]{1,3}\s?\d{1,4}\b/i.test(question);

        if (hasMobile || hasVehicleNumber) {
            return "customer";
        }

        const personalTerms = [
            "my ", "mine ", "myself ", "mere ", "meri ", "mera ",
            "mujhe ", "mere paas", "meri gaadi", "mera vehicle",
            "my account", "my details", "my status", "my records",
            "मेरी ", "मेरा ", "मेरे ", "मेरी गाड़ी", "मेरी गाड़ी"
        ];

        if (personalTerms.some(term => text.includes(term))) {
            return "customer";
        }

        // Public/company FAQ patterns remain on the general endpoint.
        const generalPatterns = [
            /\bwhat is (getrightcover|grc)\b/,
            /\b(who is|tell me about|about) (getrightcover|grc)\b/,
            /\bmembership plans?\b/,
            /\bmembership benefits?\b/,
            /\bbenefits of membership\b/,
            /\bpricing\b/,
            /\bprice of the \w+ membership\b/,
            /\bmembership fees\b/,
            /\brenewal process\b/,
            /\bhow does (membership )?renewal work\b/,
            /\bcontact (details|information|getrightcover)?\b/,
            /\bsupport (email|number|phone|contact)\b/,
            /\bofficial website\b/
        ];

        if (generalPatterns.some(pattern => pattern.test(text))) {
            return "general";
        }

        const topics = [
            "vehicle", "vehicles", "gaadi", "gadi", "वाहन", "गाड़ी",
            "challan", "चालान", "membership", "renewal", "सदस्यता",
            "insurance", "बीमा", "puc", "fitness", "tax expiry",
            "financier", "rc status", "claim", "business partner",
            "document expiry"
        ];

        const metrics = [
            "how many", "count", "number of", "total", "overall",
            "summary", "breakdown", "state wise", "state-wise",
            "dashboard", "statistics", "stats", "records", "data",
            "expiry", "expire", "expired", "expiring", "status",
            "details", "information", "top ", "highest", "most",
            "kitne", "kitni", "kitna", "kul", "कितने", "कितनी",
            "कितना", "कुल", "समाप्त", "स्थिति"
        ];

        const states = [
            "rajasthan", "gujarat", "maharashtra", "haryana", "punjab",
            "delhi", "uttar pradesh", "madhya pradesh", "tamil nadu",
            "telangana", "andhra pradesh", "karnataka", "kerala",
            "west bengal", "bihar", "राजस्थान", "गुजरात", "महाराष्ट्र"
        ];

        if (text.includes("dashboard")) {
            return "customer";
        }

        const hasTopic = topics.some(term => text.includes(term));
        const hasMetric = metrics.some(term => text.includes(term));
        const hasState = states.some(term => text.includes(term));

        if ((hasTopic && (hasMetric || hasState)) ||
            (hasState && hasMetric)) {
            return "customer";
        }

        // Keep short follow-up questions on the customer endpoint
        // while the current conversation is in customer mode.
        if (currentCustomerMode) {
            return "customer";
        }

        return "general";
    }

    /* =========================================================
       SEND MESSAGE
       ========================================================= */

    async function sendMessage(
        rawMessage
    ) {

        const message = rawMessage.trim();
        const isFileQuestion = Boolean(selectedAttachment);

        if ((!message && !isFileQuestion) || send.disabled) {
            return;
        }

        const question = message || "Please summarize the attached file.";
        const chatApiMode = isFileQuestion
            ? null
            : classifyChatEndpoint(question);

        if (chatApiMode) {
            currentCustomerMode = chatApiMode === "customer";
        }


        /*
         * Show ONLY the actual customer question.
         */

        const userDisplay = selectedAttachment
            ? `${question}\n📎 ${selectedAttachment.name}`
            : question;

        addMessage(userDisplay, "user");


        input.value =
            "";


        autoResize();


        send.disabled =
            true;


        showTyping();


        try {

            let response;

            if (selectedAttachment) {
                const formData = new FormData();
                formData.append("file", selectedAttachment);
                formData.append("question", question);
                formData.append("language", currentLanguage);

                if (currentSessionToken) {
                    formData.append("session_token", currentSessionToken);
                }

                response = await fetch("/api/chat-with-file", {
                    method: "POST",
                    body: formData
                });
            } else {
                const endpoint = chatApiMode === "customer"
                    ? "/api/chat/customer"
                    : "/api/chat/general";

                response = await fetch(endpoint, {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({
                        question: question,
                        language: currentLanguage,
                        session_token: currentSessionToken
                    })
                });
            }

            const data =
                await response.json();

            if (data.session_token) {
                currentSessionToken = data.session_token;
                saveCurrentChatSessionToken();
            }


            hideTyping();


            if (
                !response.ok
            ) {

                throw new Error(
                    data.detail ||
                    "Request failed"
                );

            }


            if (selectedAttachment) {
                selectedAttachment = null;
                attachmentInput.value = "";
                attachmentName.textContent = "";
                attachmentPreview.hidden = true;
            }

            /*
             * Only final response is shown.
             */

            addMessage(
                data.answer,
                "bot",
                data.download_url || null
            );


        }
        catch (
            error
        ) {

            hideTyping();


            addMessage(
                error && error.message
                    ? `Could not process request: ${error.message}`
                    : "Sorry, I couldn't process that request right now.",
                "bot"
            );

        }
        finally {

            send.disabled =
                false;


            input.focus();

        }

    }


    /* =========================================================
