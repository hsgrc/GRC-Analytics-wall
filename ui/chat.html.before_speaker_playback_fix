<script>


    /* =========================================================
       ELEMENTS
       ========================================================= */

    const messages =
        document.getElementById(
            "messages"
        );

    const welcome =
        document.getElementById(
            "welcome"
        );

    const form =
        document.getElementById(
            "chatForm"
        );

    const input =
        document.getElementById(
            "input"
        );

    const send =
        document.getElementById(
            "send"
        );

    const newChat =
        document.getElementById(
            "newChat"
        );


    // File attachment controls
    const attachButton = document.getElementById("attachButton");
    const attachmentInput = document.getElementById("attachmentInput");
    const attachmentPreview = document.getElementById("attachmentPreview");
    const attachmentName = document.getElementById("attachmentName");
    const removeAttachment = document.getElementById("removeAttachment");

    let selectedAttachment = null;

    attachButton.addEventListener("click", function () {
        attachmentInput.click();
    });

    attachmentInput.addEventListener("change", function () {
        const file = attachmentInput.files && attachmentInput.files[0];

        if (!file) {
            return;
        }

        // Keep the browser-side limit aligned with the upload endpoint.
        if (file.size > 15 * 1024 * 1024) {
            alert("Please select a file smaller than 15 MB.");
            attachmentInput.value = "";
            selectedAttachment = null;
            attachmentPreview.hidden = true;
            attachmentName.textContent = "";
            return;
        }

        selectedAttachment = file;
        attachmentName.textContent = file.name;
        attachmentPreview.hidden = false;
    });

    removeAttachment.addEventListener("click", function () {
        selectedAttachment = null;
        attachmentInput.value = "";
        attachmentName.textContent = "";
        attachmentPreview.hidden = true;
    });


    /* =========================================================
       LANGUAGE
       ========================================================= */

    const languageSelector =
        document.getElementById(
            "languageSelector"
        );

    const languageBtn =
        document.getElementById(
            "languageBtn"
        );

    const languageMenu =
        document.getElementById(
            "languageMenu"
        );

    const selectedLanguage =
        document.getElementById(
            "selectedLanguage"
        );


    let currentSessionToken = null;
    let currentCustomerMode = false;

    let currentLanguage =
        localStorage.getItem(
            "grc_selected_language"
        ) || "English";




    /* =========================================================
       SAVED CHAT HISTORY — LOCAL BROWSER STORAGE
       ========================================================= */

    const CHAT_HISTORY_KEY = "grc_chat_history_v1";
    const ACTIVE_CHAT_KEY = "grc_active_chat_v1";
    const MAX_SAVED_CHATS = 30;
    const MAX_MESSAGES_PER_CHAT = 80;
    const MAX_STORED_MESSAGE_CHARS = 8000;

    let chatHistory = loadChatHistory();
    let currentChatId = null;
    let isRestoringHistory = false;

    const historyBtn = document.getElementById("historyBtn");
    const historyPanel = document.getElementById("historyPanel");
    const historyBackdrop = document.getElementById("historyBackdrop");
    const historyClose = document.getElementById("historyClose");
    const historyNewChat = document.getElementById("historyNewChat");
    const historyList = document.getElementById("historyList");

    function loadChatHistory() {
        try {
            const saved = JSON.parse(
                localStorage.getItem(CHAT_HISTORY_KEY) || "[]"
            );
            if (!Array.isArray(saved)) return [];

            return saved
                .filter(chat =>
                    chat &&
                    typeof chat.id === "string" &&
                    Array.isArray(chat.messages)
                )
                .sort((a, b) =>
                    Date.parse(b.updatedAt || 0) -
                    Date.parse(a.updatedAt || 0)
                )
                .slice(0, MAX_SAVED_CHATS);
        } catch (error) {
            console.warn("Could not read saved chat history.", error);
            return [];
        }
    }

    function saveChatHistory() {
        chatHistory.sort((a, b) =>
            Date.parse(b.updatedAt || 0) -
            Date.parse(a.updatedAt || 0)
        );

        chatHistory = chatHistory.slice(0, MAX_SAVED_CHATS);

        // If browser storage is nearly full, discard the oldest chats first.
        while (chatHistory.length) {
            try {
                localStorage.setItem(
                    CHAT_HISTORY_KEY,
                    JSON.stringify(chatHistory)
                );
                return;
            } catch (error) {
                if (chatHistory.length > 1) {
                    chatHistory.pop();
                    continue;
                }

                const onlyChat = chatHistory[0];
                if (
                    onlyChat &&
                    onlyChat.messages.length > 10
                ) {
                    onlyChat.messages.shift();
                    continue;
                }

                console.warn("Chat history could not be saved.", error);
                return;
            }
        }

        localStorage.setItem(CHAT_HISTORY_KEY, "[]");
    }

    function makeChatId() {
        if (window.crypto && typeof crypto.randomUUID === "function") {
            return crypto.randomUUID();
        }
        return "chat-" + Date.now() + "-" +
            Math.random().toString(36).slice(2, 10);
    }

    function makeChatTitle(value) {
        const cleaned = String(value || "")
            .replace(/\s+/g, " ")
            .trim();

        if (!cleaned) return "New Chat";
        return cleaned.length > 45
            ? cleaned.slice(0, 45).trimEnd() + "…"
            : cleaned;
    }

    function getCurrentSavedChat(firstText, role) {
        let chat = chatHistory.find(item => item.id === currentChatId);

        if (!chat) {
            const now = new Date().toISOString();
            chat = {
                id: makeChatId(),
                title: role === "user" ? makeChatTitle(firstText) : "New Chat",
                createdAt: now,
                updatedAt: now,
                sessionToken: currentSessionToken || null,
                customerMode: currentCustomerMode,
                messages: []
            };

            chatHistory.unshift(chat);
            currentChatId = chat.id;

            try {
                localStorage.setItem(ACTIVE_CHAT_KEY, currentChatId);
            } catch (_) {}
        }

        if (
            role === "user" &&
            chat.messages.length === 0
        ) {
            chat.title = makeChatTitle(firstText);
        }

        return chat;
    }

    function saveMessageToHistory(text, role, downloadUrl) {
        if (isRestoringHistory) return;
        if (role !== "user" && role !== "bot") return;

        const chat = getCurrentSavedChat(text, role);
        let storedText = String(text == null ? "" : text);

        if (storedText.length > MAX_STORED_MESSAGE_CHARS) {
            storedText = storedText.slice(0, MAX_STORED_MESSAGE_CHARS) +
                "\n[Saved copy shortened to fit browser storage.]";
        }

        chat.messages.push({
            role,
            text: storedText,
            downloadUrl: downloadUrl || null,
            time: new Date().toISOString()
        });

        if (chat.messages.length > MAX_MESSAGES_PER_CHAT) {
            chat.messages = chat.messages.slice(-MAX_MESSAGES_PER_CHAT);
        }

        chat.updatedAt = new Date().toISOString();
        chat.sessionToken = currentSessionToken || chat.sessionToken || null;
        chat.customerMode = currentCustomerMode;

        saveChatHistory();
        renderHistoryList();
    }

    function saveCurrentChatSessionToken() {
        const chat = chatHistory.find(item => item.id === currentChatId);
        if (!chat) return;

        chat.sessionToken = currentSessionToken || null;
        chat.updatedAt = new Date().toISOString();
        saveChatHistory();
    }

    function formatHistoryDate(value) {
        const date = new Date(value || Date.now());
        if (Number.isNaN(date.getTime())) return "";

        return date.toLocaleString([], {
            month: "short",
            day: "numeric",
            hour: "2-digit",
            minute: "2-digit"
        });
    }

    function renderHistoryList() {
        if (!historyList) return;

        historyList.innerHTML = "";

        const ordered = [...chatHistory].sort((a, b) =>
            Date.parse(b.updatedAt || 0) -
            Date.parse(a.updatedAt || 0)
        );

        if (!ordered.length) {
            const empty = document.createElement("div");
            empty.className = "history-empty";
            empty.textContent =
                "No saved chats yet. Start a conversation and it will appear here.";
            historyList.appendChild(empty);
            return;
        }

        ordered.forEach(chat => {
            const entry = document.createElement("div");
            entry.className = "history-entry";

            const openButton = document.createElement("button");
            openButton.type = "button";
            openButton.className = "history-open-item" +
                (chat.id === currentChatId ? " active" : "");

            const title = document.createElement("span");
            title.className = "history-item-title";
            title.textContent = chat.title || "New Chat";

            const date = document.createElement("span");
            date.className = "history-item-date";
            date.textContent = formatHistoryDate(chat.updatedAt);

            openButton.appendChild(title);
            openButton.appendChild(date);
            openButton.addEventListener("click", () => openSavedChat(chat.id));

            const deleteButton = document.createElement("button");
            deleteButton.type = "button";
            deleteButton.className = "history-delete";
            deleteButton.textContent = "×";
            deleteButton.title = "Delete this chat";
            deleteButton.setAttribute("aria-label", "Delete " + (chat.title || "chat"));

            deleteButton.addEventListener("click", event => {
                event.stopPropagation();

                if (!window.confirm("Delete this saved conversation?")) {
                    return;
                }

                chatHistory = chatHistory.filter(item => item.id !== chat.id);
                saveChatHistory();

                if (currentChatId === chat.id) {
                    newChat.click();
                } else {
                    renderHistoryList();
                }
            });

            entry.appendChild(openButton);
            entry.appendChild(deleteButton);
            historyList.appendChild(entry);
        });
    }

    function openSavedChat(id) {
        const chat = chatHistory.find(item => item.id === id);
        if (!chat) return;

        currentChatId = chat.id;
        currentSessionToken = chat.sessionToken || null;
        currentCustomerMode = Boolean(chat.customerMode);

        try {
            localStorage.setItem(ACTIVE_CHAT_KEY, currentChatId);
        } catch (_) {}

        messages.innerHTML = "";
        welcome.classList.add("hidden");

        isRestoringHistory = true;
        try {
            chat.messages.forEach(item => {
                addMessage(item.text, item.role, item.downloadUrl || null);
            });
        } finally {
            isRestoringHistory = false;
        }

        if (!chat.messages.length) {
            messages.appendChild(welcome);
            welcome.classList.remove("hidden");
        }

        messages.scrollTop = messages.scrollHeight;
        input.value = "";
        autoResize();

        closeHistoryPanel();
        renderHistoryList();
        input.focus();
    }

    function openHistoryPanel() {
        renderHistoryList();
        historyPanel.hidden = false;
        historyBackdrop.hidden = false;
        historyBtn.setAttribute("aria-expanded", "true");
    }

    function closeHistoryPanel() {
        historyPanel.hidden = true;
        historyBackdrop.hidden = true;
        historyBtn.setAttribute("aria-expanded", "false");
    }

    historyBtn.addEventListener("click", openHistoryPanel);
    historyClose.addEventListener("click", closeHistoryPanel);
    historyBackdrop.addEventListener("click", closeHistoryPanel);

    historyNewChat.addEventListener("click", () => {
        closeHistoryPanel();
        newChat.click();
    });

    document.addEventListener("keydown", event => {
        if (event.key === "Escape" && !historyPanel.hidden) {
