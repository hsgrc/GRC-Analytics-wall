def _send_customer_overview_in_background(customer_id: str) -> None:
    """Build and send an overview without breaking the chat response."""
    try:
        snapshot = get_customer_snapshot(customer_id)
        if not snapshot:
            print("[WhatsApp overview] Customer snapshot unavailable.")
            return

        send_customer_overview_whatsapp(snapshot)
        print("[WhatsApp overview] Send function completed.")
    except Exception as exc:
        print(f"[WhatsApp overview error] {type(exc).__name__}: {exc}")


def _start_customer_overview_send(customer_id: str) -> None:
    """Start local WhatsApp Web automation in a background thread."""
    thread = threading.Thread(
        target=_send_customer_overview_in_background,
        args=(customer_id,),
        daemon=True,
        name="customer-whatsapp-overview",
    )
    thread.start()


