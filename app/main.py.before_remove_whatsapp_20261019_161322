@app.get("/api/customer-report")
def download_customer_report(
    request: Request,
    session_token: str | None = None,
):
    """Download an Excel report for the verified local customer."""
    if (
        not ENABLE_LOCAL_CUSTOMER_LOOKUP
        or not _is_local_request(request)
    ):
        raise HTTPException(status_code=404, detail="Report not available")

    session = get_session(session_token)
    if not session or not is_session_verified(session):
        raise HTTPException(status_code=404, detail="Report not available")

    customer_id = str(session.get("verified_customer_id") or "")
    snapshot = get_customer_snapshot(customer_id)
    if not snapshot:
        raise HTTPException(status_code=404, detail="Report not available")

    try:
        report_bytes = create_customer_report(snapshot)
    except Exception as exc:
        print(f"[customer report error] {exc}")
        raise HTTPException(
            status_code=500,
            detail="Could not generate the customer report.",
        ) from exc

    from io import BytesIO

    return StreamingResponse(
        BytesIO(report_bytes),
        media_type="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
        headers={
            "Content-Disposition": 'attachment; filename="GetRightCover_Customer_Report.xlsx"',
            "Cache-Control": "no-store",
        },
    )


# LOCAL DEVELOPMENT ONLY — CUSTOMER LOOKUP
# Keep ENABLE_LOCAL_CUSTOMER_LOOKUP=false on hosted deployments.
# This is not a substitute for customer authentication.
# =========================================================

@app.post("/api/dev/customer-lookup")
def dev_customer_lookup(
    payload: DevCustomerLookupRequest,
    request: Request,
):
    if not ENABLE_LOCAL_CUSTOMER_LOOKUP:
        raise HTTPException(status_code=404, detail="Not found")

    # Require both a loopback client and a localhost Host header.
    client_host = request.client.host if request.client else ""

    try:
        is_loopback = ipaddress.ip_address(client_host).is_loopback
    except ValueError:
        is_loopback = False

    request_host = (request.url.hostname or "").lower()

    if not is_loopback or request_host not in {
        "localhost", "127.0.0.1", "::1"
    }:
        raise HTTPException(
            status_code=403,
            detail="This development endpoint is only available on localhost.",
        )

    customer_id = match_customer_identity(payload.name, payload.mobile)

    if customer_id is None:
        raise HTTPException(
            status_code=404,
            detail="No unique matching customer was found.",
        )

    snapshot = get_customer_snapshot(customer_id)

    if snapshot is None:
        raise HTTPException(
            status_code=404,
            detail="No customer record was found.",
        )

    return snapshot


# ACCIDENT IMAGE ANALYSIS


@app.post("/api/analyze-accident")
async def analyze_accident(
    image: UploadFile = File(...),
):

    temp_image = None

    try:

        if not image.filename:
            raise HTTPException(
                status_code=400,
                detail="No image was provided.",
            )

        allowed_types = {
            "image/jpeg",
            "image/png",
            "image/webp",
        }

        if image.content_type not in allowed_types:
            raise HTTPException(
                status_code=400,
                detail="Please upload a JPG, PNG, or WEBP image.",
            )

        suffix = Path(
            image.filename
        ).suffix.lower()

        if suffix not in {
            ".jpg",
            ".jpeg",
            ".png",
            ".webp",
        }:
            suffix = ".jpg"

        with tempfile.NamedTemporaryFile(
            delete=False,
            suffix=suffix,
        ) as temp_file:

            temp_image = Path(
                temp_file.name
            )

            content = await image.read()

            if not content:
                raise HTTPException(
                    status_code=400,
                    detail="Uploaded image is empty.",
                )

            temp_file.write(
                content
            )

        result = analyze_accident_image(
            temp_image
        )

        return result

    except HTTPException:
        raise

    except requests.RequestException as exc:

        print(
            f"[accident vision error] {exc}"
        )

        raise HTTPException(
            status_code=502,
            detail="Accident image analysis service is unavailable.",
        )

    except Exception as exc:

        print(
            f"[accident analysis error] {exc}"
        )

        raise HTTPException(
            status_code=500,
            detail="Could not analyze the accident image.",
        )

    finally:

        if temp_image and temp_image.exists():

            try:
                temp_image.unlink()

            except OSError:
                pass

