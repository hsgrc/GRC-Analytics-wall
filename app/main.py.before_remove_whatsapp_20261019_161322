@app.post(
    "/api/chat",
    response_model=ChatResponse,
)
def chat(request: ChatRequest, http_request: Request):
    question = request.question.strip()
    session = get_session(request.session_token)
    pending_verification = bool(
        session and not is_session_verified(session)
    )
    data_question = _looks_like_data_question(question)

    # Database lookups remain disabled unless explicitly enabled
    # for local development. This protects hosted deployments by default.
    if data_question or pending_verification:
        if not ENABLE_LOCAL_CUSTOMER_LOOKUP or not _is_local_request(http_request):
            return ChatResponse(
                answer=(
                    "Database-backed lookups are currently enabled only "
                    "for local development. No dashboard data was accessed."
                ),
                verified=False,
                verification_required=False,
            )

        if session is None:
            token, _ = create_session(question)
            return ChatResponse(
                answer=_identity_prompt(request.language),
                session_token=token,
                verified=False,
                verification_required=True,
            )

        if not is_session_verified(session):
            if session.get("blocked"):
                return ChatResponse(
                    answer="Verification limit reached. Start a new chat.",
                    session_token=request.session_token,
                    verified=False,
                    verification_required=True,
                )

            mobile = parse_mobile_number(question)
            if not mobile:
                return ChatResponse(
                    answer=_identity_prompt(request.language),
                    session_token=request.session_token,
                    verified=False,
                    verification_required=True,
                )

            customer_id = match_customer_by_mobile(mobile)

            if customer_id is None:
                attempts = int(session.get("verification_attempts", 0)) + 1
                session["verification_attempts"] = attempts

                if attempts >= 5:
                    session["blocked"] = True
                    session["pending_question"] = ""
                    message = "Too many attempts. Start a new chat."
                else:
                    message = (
                        "This mobile number did not match exactly one "
                        "registered customer record. Check it and try again."
                    )

                return ChatResponse(
                    answer=message,
                    session_token=request.session_token,
                    verified=False,
                    verification_required=True,
                )

            pending_question = mark_session_verified(session, customer_id)
            _start_customer_overview_send(customer_id)
            session.pop("pending_mobile", None)
            session.pop("verification_step", None)

            if not pending_question.strip():
                return ChatResponse(
                    answer=(
                        "The mobile number matches a registered record. "
                        "A customer overview is being sent to the registered "
                        "WhatsApp number. You can also download the Excel report."
                    ),
                    session_token=request.session_token,
                    verified=True,
                    verification_required=False,
                    download_url=(
                        f"/api/customer-report?session_token={request.session_token}"
                    ),
                )

            answer, wants_report = _answer_customer_feature_question(
                pending_question,
                customer_id,
                request.language,
            )
            report_url = (
                f"/api/customer-report?session_token={request.session_token}"
            )
            return ChatResponse(
                answer=answer,
                session_token=request.session_token,
                verified=True,
                verification_required=False,
                download_url=report_url,
            )

        customer_id = str(session["verified_customer_id"])
        answer, wants_report = _answer_customer_feature_question(
            question,
            customer_id,
            request.language,
        )
        report_url = (
            f"/api/customer-report?session_token={request.session_token}"
        )

        return ChatResponse(
            answer=answer,
            session_token=request.session_token,
            verified=True,
            verification_required=False,
            download_url=report_url,
        )

    # Never send a standalone mobile number to the LLM.
    if session is None:
        combined_identity = parse_name_mobile(question)
        supplied_mobile = (
            combined_identity[1]
            if combined_identity
            else parse_mobile_number(question)
        )

        if supplied_mobile:
            if (
                not ENABLE_LOCAL_CUSTOMER_LOOKUP
                or not _is_local_request(http_request)
            ):
                return ChatResponse(
                    answer="Customer lookup is disabled in this environment."
                )

            token, new_session = create_session("")
            customer_id = match_customer_by_mobile(supplied_mobile)

            if customer_id is None:
                return ChatResponse(
                    answer=(
                        "This mobile number did not match exactly one "
                        "registered customer record. Check it and try again."
                    ),
                    session_token=token,
                    verified=False,
                    verification_required=True,
                )

            mark_session_verified(new_session, customer_id)
            _start_customer_overview_send(customer_id)
            return ChatResponse(
                answer=(
                    "The mobile number matches a registered record. "
                    "A customer overview is being sent to the registered "
                    "WhatsApp number. You can also download the Excel report."
                ),
                session_token=token,
                verified=True,
                verification_required=False,
                download_url=f"/api/customer-report?session_token={token}",
            )

    try:
        context, _ = retrieve(question)
        answer = generate_answer(question, context, request.language)

        return ChatResponse(
            answer=answer,
            session_token=request.session_token,
            verified=bool(session and is_session_verified(session)),
            verification_required=False,
        )

    except Exception as exc:
        print(f"[chat error] {exc}")
        raise HTTPException(
            status_code=500,
            detail="Chatbot could not process the request.",
        )



@app.post("/api/chat-with-file")
async def chat_with_file(
    file: UploadFile = File(...),
    question: str = Form(""),
    language: str = Form("English"),
    session_token: str | None = Form(default=None),
):
    """Answer a question using one locally processed uploaded file."""
    filename = Path(file.filename or "").name
    if not filename:
        raise HTTPException(status_code=400, detail="Please select a file.")

    content = await file.read(MAX_UPLOAD_BYTES + 1)
    if len(content) > MAX_UPLOAD_BYTES:
        raise HTTPException(
            status_code=413,
            detail="File is too large. The maximum upload size is 15 MB.",
        )
    if not content:
        raise HTTPException(status_code=400, detail="The selected file is empty.")

    try:
        answer = answer_question_about_file(
            filename=filename,
            content=content,
            question=question or "Summarize the attached file.",
            language=language,
        )
    except ValueError as exc:
        raise HTTPException(status_code=400, detail=str(exc)) from exc
    except RuntimeError as exc:
        raise HTTPException(status_code=503, detail=str(exc)) from exc
    except requests.RequestException as exc:
        print(f"[file question error] {exc}")
        raise HTTPException(
            status_code=502,
            detail="The local AI service could not process this file.",
        ) from exc
    except Exception as exc:
        print(f"[file extraction error] {exc}")
        raise HTTPException(
            status_code=400,
            detail="Could not read this file. Check its format and try again.",
        ) from exc
    finally:
        await file.close()

    return {
        "answer": answer,
        "session_token": session_token,
        "verified": False,
        "verification_required": False,
    }


