def _answer_customer_data_question(
    question: str,
    customer_id: str,
    language: str,
) -> str:
    """
    Answer structured questions only from source JSON records.
    Vehicle-level information is restricted to vehicles linked
    to the successfully matched customer record.
    """
    indexed_vehicle = find_vehicle_number_in_text(question)
    match = _VEHICLE_NUMBER_PATTERN.search(question)

    # Prefer an exact known registration from the JSON index.
    detected_vehicle = (
        indexed_vehicle
        or (match.group(1) if match else None)
    )

    if detected_vehicle:
        requested_number = normalize_vehicle(detected_vehicle)
        customer_snapshot = get_customer_snapshot(customer_id)

        owned_vehicle = next(
            (
                item for item in (customer_snapshot or {}).get("vehicles", [])
                if normalize_vehicle(
                    (item.get("vehicle") or {}).get("vehicle_number")
                ) == requested_number
            ),
            None,
        )

        if not owned_vehicle:
            return (
                "I couldn't find that vehicle linked to your verified "
                "GetRightCover account. Please check the registration number."
            )

        vehicle = owned_vehicle.get("vehicle") or {}
        lines = ["Vehicle details from your linked account:"]

        for label, key in (
            ("Vehicle number", "vehicle_number"),
            ("Make", "make"),
            ("Model", "model"),
            ("State", "state"),
            ("Registered at", "registered_at"),
            ("Insurance company", "insurance_company"),
            ("Financier", "financier"),
        ):
            value = vehicle.get(key)
            if value is not None and str(value).strip():
                lines.append(f"{label}: {str(value).strip()}")

        q = question.casefold()

        # Always include available document expiry details when a
        # verified customer asks about one of their linked vehicles.
        lines.extend(["", "Document expiry details:"])
        documents = owned_vehicle.get("documents", [])
        if documents:
            for item in documents:
                lines.append(
                    f"- {item.get('document')}: "
                    f"{item.get('expiry_date') or 'Date unavailable'} — "
                    f"{item.get('status') or 'Status unavailable'}"
                )
        else:
            lines.append("- No document expiry records are available.")

        if any(x in q for x in ("membership", "renewal", "सदस्यता")):
            for item in owned_vehicle.get("memberships", []):
                lines.extend([
                    "",
                    f"Membership type: {item.get('membership_type') or 'Unavailable'}",
                    f"Start date: {item.get('start_date') or 'Unavailable'}",
                    f"End date: {item.get('end_date') or 'Unavailable'}",
                    f"Membership status: {item.get('status') or 'Unavailable'}",
                ])

        if "claim" in q:
            indicator = owned_vehicle.get("claim_indicator") or {}
            lines.append(
                "\nClaim indicator: "
                + ("Claim flag present" if indicator.get("has_claim_flag")
                   else "No matching claim flag found")
            )

        # Include individual challan matches from the local workbook.
        # This is reached only after confirming the vehicle belongs to
        # the verified customer's own snapshot.
        challan_records = get_vehicle_challans(requested_number)
        court_records = [
            record for record in challan_records
            if record.get("type") == "Court"
        ]
        e_challan_records = [
            record for record in challan_records
            if record.get("type") == "E-Challan"
        ]

        lines.extend([
            "",
            "Vehicle-wise challan summary (local source):",
            f"- Court challans: {len(court_records)}",
            f"- E-Challans: {len(e_challan_records)}",
            f"- Total matched challan records: {len(challan_records)}",
        ])

        if challan_records:
            lines.append("")
            lines.append("Challan details:")
            for record in challan_records[:25]:
                amount = record.get("amount")
                amount_text = (
                    f"₹{amount}" if amount is not None and str(amount).strip()
                    else "Amount unavailable"
                )
                lines.append(
                    f"- {record.get('type') or 'Challan'}"
                    f" | Challan No: {record.get('challan_number') or 'Unavailable'}"
                    f" | Date/Time: {record.get('date_time') or 'Unavailable'}"
                    f" | Payment: {record.get('payment_status') or 'Unavailable'}"
                    f" | Amount: {amount_text}"
                )

            if len(challan_records) > 25:
                lines.append(
                    f"...{len(challan_records) - 25} additional matching records "
                    "were omitted from this chat response."
                )
        else:
            lines.append(
                "No matching records were found in the local challan workbook. "
                "This does not prove that no challans exist in other sources."
            )

        if "rc" in q or "registration status" in q:
            statuses = owned_vehicle.get("rc_statuses", [])
            lines.extend(["", "RC status:"])
            if statuses:
                lines.extend(
                    f"- {item.get('status') or 'Status unavailable'}"
                    for item in statuses
                )
            else:
                lines.append("No RC status record found for this vehicle.")

        return "\n".join(lines)

    # Personal vehicle queries must use the verified customer's own snapshot.
    q = question.casefold()

    personal_reference = (
        any(term in q for term in (
            "my vehicle", "my vehicles", "do i have", "i have",
            "mere vehicle", "meri gaadi", "mera vehicle",
            "my account", "mere saare", "meri saari",
            "is number se", "iss number se",
            "is mobile number se", "iss mobile number se",
            "is mobile se", "iss mobile se",
            "is phone se", "iss phone se",
            "mere number se", "mere mobile se",
            "this mobile number", "this phone number",
        ))
        or bool(re.search(
            r"\b(?:my|mine|mera|meri|mere|mujhe|hamari|hamare)\b",
            q,
        ))
        or any(term in q for term in (
            "मेरे", "मेरी", "मेरा", "मुझे", "हमारे", "हमारी"
        ))
    )

    vehicle_reference = any(
        term in q for term in (
            "vehicle", "vehicl", "gaadi", "gadi", "car", "truck",
            "वाहन", "गाड़ी", "गाड़ी", "गाडी"
        )
    )

    asks_about_own_vehicles = (
        any(term in q for term in (
            "my vehicle", "my vehicles", "do i have", "i have",
            "mere vehicle", "meri gaadi", "mera vehicle",
            "मेरे वाहन", "मेरी गाड़ी"
        ))
        or (personal_reference and vehicle_reference)
    )

    if asks_about_own_vehicles:
        customer_snapshot = get_customer_snapshot(customer_id)
        own_vehicles = (customer_snapshot or {}).get("vehicles", [])

        if not own_vehicles:
            return (
                "No linked vehicle records were found for your account."
            )

        # Aggregate challan summaries do not identify individual vehicles.
        if "challan" in q or "चालान" in q:
            lang = (language or "English").strip().lower()

            if lang == "hindi":
                return (
                    "मौजूदा JSON डेटा में कुल चालान के सारांश उपलब्ध हैं, "
                    "लेकिन आपके प्रत्येक वाहन के चालान रिकॉर्ड उपलब्ध नहीं हैं। "
                    "इसलिए आपके कितने वाहनों पर चालान हैं, इसकी सही संख्या "
                    "अभी नहीं निकाली जा सकती।"
                )

            if lang == "hinglish":
                return (
                    "Current JSON mein aggregate challan summaries hain, "
                    "lekin individual vehicle-wise challan records nahi hain. "
                    "Isliye aapki kitni vehicles par challans hain, uska "
                    "accurate count abhi nahi nikal sakta."
                )

            return (
                "The current JSON contains aggregate challan summaries, "
                "but not individual vehicle-level challan records. I cannot "
                "accurately count how many of your vehicles have challans "
                "until those records are available."
            )

        count_question = any(term in q for term in (
            "how many", "kitne", "kitni", "kitna", "count", "total",
            "kul", "कितने", "कितनी", "कितना", "कुल"
        ))

        wants_list = any(term in q for term in (
            "all", "saare", "sare", "sabhi", "every", "list",
            "numbers", "number bata", "number batado", "bata do",
            "batado", "registration", "सारे", "सभी", "नंबर"
        ))

        lang = (language or "English").strip().lower()

        if count_question and not wants_list:
            count = len(own_vehicles)

            if lang == "hindi":
                return f"आपके अकाउंट से {count} वाहन जुड़े हुए हैं।"
            if lang == "hinglish":
                return f"Aapke account se {count} vehicles linked hain."
            return f"There are {count} vehicles linked to your account."

        lines = [
            f"Vehicles linked to your account: {len(own_vehicles)}"
        ]

        for item in own_vehicles:
            vehicle = item.get("vehicle") or {}
            label = vehicle.get("vehicle_number") or "Registration unavailable"
            description = " ".join(
                str(vehicle.get(key)).strip()
                for key in ("make", "model")
                if vehicle.get(key)
            )
            lines.append(
                f"- {label}" +
                (f" — {description}" if description else "")
            )

        if any(x in q for x in (
            "expiry", "expire", "insurance", "puc", "fitness",
            "tax", "document", "status", "दस्तावेज़", "बीमा", "समाप्त"
        )):
            for item in own_vehicles:
                vehicle = item.get("vehicle") or {}
                lines.append(
                    f"\n{vehicle.get('vehicle_number') or 'Vehicle'}:"
                )
                for doc in item.get("documents", []):
                    lines.append(
                        f"- {doc.get('document')}: "
                        f"{doc.get('expiry_date') or 'Date unavailable'} — "
                        f"{doc.get('status') or 'Status unavailable'}"
                    )

        return "\n".join(lines)

    # Aggregate dashboard JSON is read only after verification.
    answer = answer_dashboard_question(question, language)
    if answer:
        return answer

    return (
        "I couldn't find a supported answer to that question in the "
        "currently available dashboard summary data. I won't guess a number. "
        "The query rules or source dataset may need to be expanded."
    )


def _answer_customer_feature_question(
    question: str,
    customer_id: str,
    language: str,
) -> tuple[str, bool]:
    """Dispatch verified-customer questions to approved feature helpers."""
    if is_report_request(question):
        return (
            "Your customer report is ready to download. Use the download link below.",
            True,
        )

    if is_customer_360_question(question) or is_renewal_expiry_question(question):
        snapshot = get_customer_snapshot(customer_id)
        if snapshot is None:
            return (
                "I couldn't retrieve the linked customer records. No report was generated.",
                False,
            )

        if is_customer_360_question(question):
            return build_customer_360_answer(snapshot), False

        return build_renewal_expiry_answer(snapshot, question, language), False

    return _answer_customer_data_question(question, customer_id, language), False


