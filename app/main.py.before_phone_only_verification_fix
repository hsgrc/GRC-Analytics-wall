def _looks_like_data_question(question: str) -> bool:
    """Detect a database question without opening any data files."""
    text = question.casefold()

    if (
        _VEHICLE_NUMBER_PATTERN.search(question)
        or find_vehicle_number_in_text(question)
    ):
        return True

    topics = (
        "vehicle", "vehicles", "gaadi", "gadi", "वाहन", "गाड़ी",
        "challan", "चालान", "membership", "renewal", "सदस्यता",
        "insurance", "बीमा", "puc", "fitness", "tax expiry",
        "financier", "rc status", "claim", "business partner",
    )
    metrics = (
        "how many", "count", "number of", "total", "overall",
        "summary", "breakdown", "state wise", "state-wise",
        "dashboard", "statistics", "stats", "records", "data",
        "expiry", "expire", "expired", "expiring", "status",
        "details", "information", "top ", "highest", "most",
        "kitne", "kitni", "kitna", "kul", "mere", "meri", "mera",
        "my vehicle", "my membership", "do i have", "i have",
        "कितने", "कितनी", "कितना", "कुल", "समाप्त", "स्थिति",
    )

    if "dashboard" in text:
        return True

    has_topic = any(term in text for term in topics)
    has_metric = any(term in text for term in metrics)
    has_state = any(state in text for state in _STATE_NAMES)

    return has_topic and (has_metric or has_state)


def _is_local_request(http_request: Request) -> bool:
    """Require a loopback client and local Host header."""
    client_host = http_request.client.host if http_request.client else ""

    try:
        loopback = ipaddress.ip_address(client_host).is_loopback
    except ValueError:
        loopback = False

    host = (http_request.url.hostname or "").lower()
    return loopback and host in {"localhost", "127.0.0.1", "::1"}


