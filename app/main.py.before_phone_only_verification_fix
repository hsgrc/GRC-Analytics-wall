@app.post(
    "/api/chat",
    response_model=ChatResponse,
)
def chat(request: ChatRequest, http_request: Request):
    question = request.question.strip()
    session = get_session(request.session_token)
    pending_verification = bool(
        session and not is_session_verified(session)
    )
    data_question = _looks_like_data_question(question)

    # Database lookups remain disabled unless explicitly enabled
    # for local development. This protects hosted deployments by default.
    if data_question or pending_verification:
        if not ENABLE_LOCAL_CUSTOMER_LOOKUP or not _is_local_request(http_request):
            return ChatResponse(
                answer=(
                    "Database-backed lookups are currently enabled only "
                    "for local development. No dashboard data was accessed."
                ),
                verified=False,
                verification_required=False,
            )

        if session is None:
            token, _ = create_session(question)
            return ChatResponse(
                answer=_identity_prompt(request.language),
                session_token=token,
                verified=False,
                verification_required=True,
            )

        if not is_session_verified(session):
            identity = parse_name_mobile(question)

            if not identity:
                return ChatResponse(
                    answer=_identity_prompt(request.language),
                    session_token=request.session_token,
                    verified=False,
                    verification_required=True,
                )

            name, mobile = identity
            customer_id = match_customer_identity(name, mobile)

            if customer_id is None:
                attempts = int(session.get("verification_attempts", 0)) + 1
                session["verification_attempts"] = attempts

                if attempts >= 5:
                    session["blocked"] = True
                    session["pending_question"] = ""
                    message = (
                        "Verification attempts limit reached. Start a new chat "
                        "and try again with the registered name and mobile number."
                    )
                else:
                    message = (
                        "The details could not be matched. Please check the "
                        "registered full name and mobile number, then try again."
                    )

                return ChatResponse(
                    answer=message,
                    session_token=request.session_token,
                    verified=False,
                    verification_required=True,
                )

            pending_question = mark_session_verified(session, customer_id)
            original_question = pending_question or question

            answer = _answer_customer_data_question(
                original_question,
                customer_id,
                request.language,
            )

            return ChatResponse(
                answer=answer,
                session_token=request.session_token,
                verified=True,
                verification_required=False,
            )

        if session.get("blocked"):
            return ChatResponse(
                answer="This verification session is blocked. Start a new chat.",
                verified=False,
                verification_required=True,
            )

        customer_id = str(session["verified_customer_id"])
        answer = _answer_customer_data_question(
            question,
            customer_id,
            request.language,
        )

        return ChatResponse(
            answer=answer,
            session_token=request.session_token,
            verified=True,
            verification_required=False,
        )

    # Do not send a name + phone verification message to the LLM
    # if its session token is missing or expired.
    if session is None and parse_name_mobile(question):
        return ChatResponse(
            answer=(
                "There is no active verification session for those details. "
                "Ask your dashboard or vehicle question first, then follow "
                "the verification prompt."
            ),
        )

    try:
        context, _ = retrieve(question)
        answer = generate_answer(question, context, request.language)

        return ChatResponse(
            answer=answer,
            session_token=request.session_token,
            verified=bool(session and is_session_verified(session)),
            verification_required=False,
        )

    except Exception as exc:
        print(f"[chat error] {exc}")
        raise HTTPException(
            status_code=500,
            detail="Chatbot could not process the request.",
        )


# =========================================================
# LOCAL DEVELOPMENT ONLY — CUSTOMER LOOKUP
# Keep ENABLE_LOCAL_CUSTOMER_LOOKUP=false on hosted deployments.
# This is not a substitute for customer authentication.
# =========================================================

@app.post("/api/dev/customer-lookup")
def dev_customer_lookup(
    payload: DevCustomerLookupRequest,
    request: Request,
):
    if not ENABLE_LOCAL_CUSTOMER_LOOKUP:
        raise HTTPException(status_code=404, detail="Not found")

    # Require both a loopback client and a localhost Host header.
    client_host = request.client.host if request.client else ""

    try:
        is_loopback = ipaddress.ip_address(client_host).is_loopback
    except ValueError:
        is_loopback = False

    request_host = (request.url.hostname or "").lower()

    if not is_loopback or request_host not in {
        "localhost", "127.0.0.1", "::1"
    }:
        raise HTTPException(
            status_code=403,
            detail="This development endpoint is only available on localhost.",
        )

    customer_id = match_customer_identity(payload.name, payload.mobile)

    if customer_id is None:
        raise HTTPException(
            status_code=404,
            detail="No unique matching customer was found.",
        )

    snapshot = get_customer_snapshot(customer_id)

    if snapshot is None:
        raise HTTPException(
            status_code=404,
            detail="No customer record was found.",
        )

    return snapshot


# ACCIDENT IMAGE ANALYSIS


@app.post("/api/analyze-accident")
async def analyze_accident(
    image: UploadFile = File(...),
):

    temp_image = None

    try:

        if not image.filename:
            raise HTTPException(
                status_code=400,
                detail="No image was provided.",
            )

        allowed_types = {
            "image/jpeg",
            "image/png",
            "image/webp",
        }

        if image.content_type not in allowed_types:
            raise HTTPException(
                status_code=400,
                detail="Please upload a JPG, PNG, or WEBP image.",
            )

        suffix = Path(
            image.filename
        ).suffix.lower()

        if suffix not in {
            ".jpg",
            ".jpeg",
            ".png",
            ".webp",
        }:
            suffix = ".jpg"

        with tempfile.NamedTemporaryFile(
            delete=False,
            suffix=suffix,
        ) as temp_file:

            temp_image = Path(
                temp_file.name
            )

            content = await image.read()

            if not content:
                raise HTTPException(
                    status_code=400,
                    detail="Uploaded image is empty.",
                )

            temp_file.write(
                content
            )

        result = analyze_accident_image(
            temp_image
        )

        return result

    except HTTPException:
        raise

    except requests.RequestException as exc:

        print(
            f"[accident vision error] {exc}"
        )

        raise HTTPException(
            status_code=502,
            detail="Accident image analysis service is unavailable.",
        )

    except Exception as exc:

        print(
            f"[accident analysis error] {exc}"
        )

        raise HTTPException(
            status_code=500,
            detail="Could not analyze the accident image.",
        )

    finally:

        if temp_image and temp_image.exists():

            try:
                temp_image.unlink()

            except OSError:
                pass

