# =========================================================
# HEALTH CHECK
# =========================================================

@app.get("/api/health")
def health():

    try:

        r = requests.get(
            f"{OLLAMA_BASE_URL}/api/tags",
            timeout=5,
        )

        ollama = r.ok

    except requests.RequestException:

        ollama = False

    return {
        "status": "ok",
        "ollama": ollama,
        "model": OLLAMA_MODEL,
        "knowledge_exists": KNOWLEDGE_FILE.exists(),
    }


# =========================================================
# NORMAL TEXT CHAT
# =========================================================

@app.post(
    "/api/chat",
    response_model=ChatResponse,
)
def chat(request: ChatRequest):

    question = request.question.strip()

    try:

        context, _ = retrieve(
            question
        )

        answer = generate_answer(
            question,
            context,
            request.language,
        )

        return ChatResponse(
            answer=answer
        )

    except Exception as exc:

        print(
            f"[chat error] {exc}"
        )

        raise HTTPException(
            status_code=500,
            detail=(
                "Chatbot could not "
                "process the request."
            ),
        )


# ACCIDENT IMAGE ANALYSIS


@app.post("/api/analyze-accident")
async def analyze_accident(
    image: UploadFile = File(...),
):

    temp_image = None

    try:

        if not image.filename:
            raise HTTPException(
                status_code=400,
                detail="No image was provided.",
            )

        allowed_types = {
            "image/jpeg",
            "image/png",
            "image/webp",
        }

        if image.content_type not in allowed_types:
            raise HTTPException(
                status_code=400,
                detail="Please upload a JPG, PNG, or WEBP image.",
            )

        suffix = Path(
            image.filename
        ).suffix.lower()

        if suffix not in {
            ".jpg",
            ".jpeg",
            ".png",
            ".webp",
        }:
            suffix = ".jpg"

        with tempfile.NamedTemporaryFile(
            delete=False,
            suffix=suffix,
        ) as temp_file:

            temp_image = Path(
                temp_file.name
            )

            content = await image.read()

            if not content:
                raise HTTPException(
                    status_code=400,
                    detail="Uploaded image is empty.",
                )

            temp_file.write(
                content
            )

        result = analyze_accident_image(
            temp_image
        )

        return result

    except HTTPException:
        raise

    except requests.RequestException as exc:

        print(
            f"[accident vision error] {exc}"
        )

        raise HTTPException(
            status_code=502,
            detail="Accident image analysis service is unavailable.",
        )

    except Exception as exc:

        print(
            f"[accident analysis error] {exc}"
        )

        raise HTTPException(
            status_code=500,
            detail="Could not analyze the accident image.",
        )

    finally:

        if temp_image and temp_image.exists():

            try:
                temp_image.unlink()

            except OSError:
                pass

# =========================================================
# DOCUMENT IMAGE ENHANCER
# =========================================================

@app.post("/api/enhance-document")
async def enhance_document_endpoint(
    image: UploadFile = File(...),
):
    input_path = None
    output_path = None

    try:
        if not image.filename:
            raise HTTPException(
                status_code=400,
                detail="No image was provided.",
            )

        allowed_types = {
            "image/jpeg",
            "image/png",
            "image/webp",
        }

        if image.content_type not in allowed_types:
            raise HTTPException(
                status_code=400,
                detail="Please upload a JPG, PNG, or WEBP image.",
            )

        suffix = Path(
            image.filename
        ).suffix.lower()

        if suffix not in {
            ".jpg",
            ".jpeg",
            ".png",
            ".webp",
        }:
            suffix = ".jpg"

        with tempfile.NamedTemporaryFile(
            delete=False,
            suffix=suffix,
        ) as temp_file:

            input_path = Path(
                temp_file.name
            )

            content = await image.read()

            if not content:
                raise HTTPException(
                    status_code=400,
                    detail="Uploaded image is empty.",
                )

            temp_file.write(content)

        output_file = tempfile.NamedTemporaryFile(
            delete=False,
            suffix=".png",
        )

        output_file.close()

        output_path = Path(
            output_file.name
        )

        enhance_document(
            input_path,
            output_path,
        )

        return FileResponse(
            path=output_path,
            media_type="image/png",
            filename="enhanced-document.png",
        )

    except HTTPException:
        raise

    except Exception as exc:

        print(
            f"[document enhancer error] {exc}"
        )

        raise HTTPException(
            status_code=500,
            detail="Could not enhance the document image.",
        )

    finally:

        if input_path and input_path.exists():

            try:
                input_path.unlink()
            except OSError:
                pass

