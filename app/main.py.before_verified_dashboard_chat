@app.post("/api/enhance-document")
async def enhance_document_endpoint(
    image: UploadFile = File(...),
):
    input_path = None
    output_path = None

    try:
        if not image.filename:
            raise HTTPException(
                status_code=400,
                detail="No image was provided.",
            )

        allowed_types = {
            "image/jpeg",
            "image/png",
            "image/webp",
        }

        if image.content_type not in allowed_types:
            raise HTTPException(
                status_code=400,
                detail="Please upload a JPG, PNG, or WEBP image.",
            )

        suffix = Path(
            image.filename
        ).suffix.lower()

        if suffix not in {
            ".jpg",
            ".jpeg",
            ".png",
            ".webp",
        }:
            suffix = ".jpg"

        with tempfile.NamedTemporaryFile(
            delete=False,
            suffix=suffix,
        ) as temp_file:

            input_path = Path(
                temp_file.name
            )

            content = await image.read()

            if not content:
                raise HTTPException(
                    status_code=400,
                    detail="Uploaded image is empty.",
                )

            temp_file.write(content)

        output_file = tempfile.NamedTemporaryFile(
            delete=False,
            suffix=".png",
        )

        output_file.close()

        output_path = Path(
            output_file.name
        )

        enhance_document(
            input_path,
            output_path,
        )

        return FileResponse(
            path=output_path,
            media_type="image/png",
            filename="enhanced-document.png",
        )

    except HTTPException:
        raise

    except Exception as exc:

        print(
            f"[document enhancer error] {exc}"
        )

        raise HTTPException(
            status_code=500,
            detail="Could not enhance the document image.",
        )

    finally:

        if input_path and input_path.exists():

            try:
                input_path.unlink()
            except OSError:
                pass

