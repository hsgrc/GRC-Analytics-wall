# =========================================================
# VEHICLE DATABASE LOOKUP
# =========================================================

_VEHICLE_NUMBER_PATTERN = re.compile(
    r"(?<![A-Z0-9])"
    r"("
    r"[A-Z]{2}\s*0?\d{1,2}\s*[A-Z]{0,3}\s*\d{1,4}"
    r"|"
    r"\d{2}\s*BH\s*\d{4}\s*[A-Z]{1,2}"
    r")"
    r"(?![A-Z0-9])",
    re.IGNORECASE,
)


def _vehicle_lookup_answer(question: str, language: str) -> str | None:
    match = _VEHICLE_NUMBER_PATTERN.search(question)
    if not match:
        return None

    vehicle_number = match.group(1)
    snapshot = get_vehicle_snapshot(vehicle_number)

    lang = (language or "English").strip().lower()

    if snapshot is None:
        messages = {
            "hindi": (
                "इस वाहन का रिकॉर्ड मौजूदा स्थानीय डेटाबेस में नहीं मिला। "
                "कृपया वाहन रजिस्ट्रेशन नंबर जाँचें।"
            ),
            "hinglish": (
                "Ye vehicle current local database mein nahi mila. "
                "Vehicle registration number check karke dobara try karein."
            ),
            "english": (
                "I couldn't find this vehicle in the current local database. "
                "Please check the registration number."
            ),
        }
        return messages.get(lang, messages["english"])

    vehicle = snapshot.get("vehicle") or {}

    headings = {
        "hindi": "स्थानीय डेटाबेस में वाहन की जानकारी मिली:",
        "hinglish": "Local database mein vehicle ki information mili:",
        "english": "Vehicle information found in the local database:",
    }
    heading = headings.get(lang, headings["english"])

    lines = [heading, ""]

    fields = [
        ("Vehicle number", vehicle.get("vehicle_number")),
        ("Make", vehicle.get("make")),
        ("Model", vehicle.get("model")),
        ("Registered state", vehicle.get("state")),
        ("Registered at", vehicle.get("registered_at")),
        ("Insurance company", vehicle.get("insurance_company")),
    ]

    for label, value in fields:
        if value is not None and str(value).strip():
            lines.append(f"{label}: {str(value).strip()}")

    documents = snapshot.get("documents", [])
    if documents:
        lines.extend(["", "Document expiry status:"])
        for item in documents:
            name = item.get("document") or "Document"
            expiry = item.get("expiry_date") or "Date unavailable"
            status = item.get("status") or "Status unavailable"
            lines.append(f"- {name}: {expiry} — {status}")

    rc_statuses = snapshot.get("rc_statuses", [])
    available_statuses = [
        str(item.get("status")).strip()
        for item in rc_statuses
        if item.get("status") and str(item.get("status")).strip()
    ]

    if available_statuses:
        lines.extend(["", "RC status:"])
        lines.extend(f"- {status}" for status in available_statuses)

    lines.extend([
        "",
        "Source: local vehicle database.",
        "Membership and personal claim details are not included in this response.",
    ])

    return "\n".join(lines)


# =========================================================
# NORMAL TEXT CHAT
# =========================================================

@app.post(
    "/api/chat",
    response_model=ChatResponse,
)
def chat(request: ChatRequest):

    question = request.question.strip()

    try:

        vehicle_answer = _vehicle_lookup_answer(
            question,
            request.language,
        )

        if vehicle_answer is not None:
            return ChatResponse(answer=vehicle_answer)

        context, _ = retrieve(
            question
        )

        answer = generate_answer(
            question,
            context,
            request.language,
        )

        return ChatResponse(
            answer=answer
        )

    except Exception as exc:

        print(
            f"[chat error] {exc}"
        )

        raise HTTPException(
            status_code=500,
            detail=(
                "Chatbot could not "
                "process the request."
            ),
        )


# =========================================================
# LOCAL DEVELOPMENT ONLY — CUSTOMER LOOKUP
# Keep ENABLE_LOCAL_CUSTOMER_LOOKUP=false on hosted deployments.
# This is not a substitute for customer authentication.
# =========================================================

@app.post("/api/dev/customer-lookup")
def dev_customer_lookup(
    payload: DevCustomerLookupRequest,
    request: Request,
):
    if not ENABLE_LOCAL_CUSTOMER_LOOKUP:
        raise HTTPException(status_code=404, detail="Not found")

    # Require both a loopback client and a localhost Host header.
    client_host = request.client.host if request.client else ""

    try:
        is_loopback = ipaddress.ip_address(client_host).is_loopback
    except ValueError:
        is_loopback = False

    request_host = (request.url.hostname or "").lower()

    if not is_loopback or request_host not in {
        "localhost", "127.0.0.1", "::1"
    }:
        raise HTTPException(
            status_code=403,
            detail="This development endpoint is only available on localhost.",
        )

    customer_id = match_customer_identity(payload.name, payload.mobile)

    if customer_id is None:
        raise HTTPException(
            status_code=404,
            detail="No unique matching customer was found.",
        )

    snapshot = get_customer_snapshot(customer_id)

    if snapshot is None:
        raise HTTPException(
            status_code=404,
            detail="No customer record was found.",
        )

    return snapshot


# ACCIDENT IMAGE ANALYSIS


@app.post("/api/analyze-accident")
async def analyze_accident(
    image: UploadFile = File(...),
):

    temp_image = None

    try:

        if not image.filename:
            raise HTTPException(
                status_code=400,
                detail="No image was provided.",
            )

        allowed_types = {
            "image/jpeg",
            "image/png",
            "image/webp",
        }

        if image.content_type not in allowed_types:
            raise HTTPException(
                status_code=400,
                detail="Please upload a JPG, PNG, or WEBP image.",
            )

        suffix = Path(
            image.filename
        ).suffix.lower()

        if suffix not in {
            ".jpg",
            ".jpeg",
            ".png",
            ".webp",
        }:
            suffix = ".jpg"

        with tempfile.NamedTemporaryFile(
            delete=False,
            suffix=suffix,
        ) as temp_file:

            temp_image = Path(
                temp_file.name
            )

            content = await image.read()

            if not content:
                raise HTTPException(
                    status_code=400,
                    detail="Uploaded image is empty.",
                )

            temp_file.write(
                content
            )

        result = analyze_accident_image(
            temp_image
        )

        return result

    except HTTPException:
        raise

    except requests.RequestException as exc:

        print(
            f"[accident vision error] {exc}"
        )

        raise HTTPException(
            status_code=502,
            detail="Accident image analysis service is unavailable.",
        )

    except Exception as exc:

        print(
            f"[accident analysis error] {exc}"
        )

        raise HTTPException(
            status_code=500,
            detail="Could not analyze the accident image.",
        )

    finally:

        if temp_image and temp_image.exists():

            try:
                temp_image.unlink()

            except OSError:
                pass

